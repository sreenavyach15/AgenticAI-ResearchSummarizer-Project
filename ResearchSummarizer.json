    {
      "parameters": {
        "jsCode": "// Access raw data safely\nconst rawData = $json.data || $json.body || $json; \n\n// If rawData is an object (not string), convert it\nconst xmlString = typeof rawData === \"string\" ? rawData : JSON.stringify(rawData);\n\n// Extract <entry> elements\nconst entries = xmlString.split(\"<entry>\").slice(1, 6);\n\nconst papers = entries.map(entry => {\n  const title = entry.match(/<title>(.*?)<\\/title>/s)?.[1]?.trim() || \"No title found\";\n  const summary = entry.match(/<summary>(.*?)<\\/summary>/s)?.[1]?.trim() || \"No summary available\";\n  return { title, summary };\n});\n\nreturn [{ papers }];\n"
      },
